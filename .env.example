# ============================================
# LiveKit Configuration
# ============================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ============================================
# Sarvam AI (STT/TTS)
# Get free key at https://sarvam.ai
# ============================================
SARVAM_API_KEY=your_sarvam_api_key

# ============================================
# LLM Providers (configure at least one)
# The system will automatically select the first available provider
# ============================================

# OpenRouter (Free) - Get free key at https://openrouter.ai
# Default model: google/gemma-4-31b-it:free
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Kilo AI (Free) - Get free key at https://kilo.ai
# Default model: nvidia/nemotron-3-super-120b-a12b:free
KILO_API_KEY=your_kilo_api_key
KILO_API_BASE=https://api.kilo.ai

# Ollama (Free) - Get free key at https://cloud.ollama.ai
# Default model: llama3.2:latest
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_API_BASE=http://localhost:11434

# OpenAI (Paid) - Get key at https://platform.openai.com
# Default model: gpt-4o-mini
# Note: This will only be used if OPENAI_API_KEY does NOT start with "sk-or-"
# OPENAI_API_KEY=sk-your_openai_api_key

# ============================================
# Optional Configuration
# ============================================

# Custom model for spam classification (overrides provider default)
# SPAM_CLASSIFICATION_MODEL=custom-model-name

# ============================================
# Telegram Notifications
# Get bot token from @BotFather: https://t.me/BotFather
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================
# Optional TRAI Report Confirmation
# ============================================

# Public URL for the confirmation page used by Telegram's "Report to TRAI" button.
# Example after exposing the local report server:
# TRAI_REPORT_CONFIRM_URL=https://your-public-domain.example/report
# Run locally with: uv run python -m src.report_server
# TRAI_REPORT_SERVER_HOST=127.0.0.1
# TRAI_REPORT_SERVER_PORT=8787
