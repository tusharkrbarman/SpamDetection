# LiveKit Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Sarvam AI (STT/TTS) - Get free key at https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key

# OpenRouter (LLM) - Get free key at https://openrouter.ai
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Ollama Cloud (fallback LLM) - Get free key at https://cloud.ollama.ai
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_API_BASE=https://cloud.ollama.ai

# Kilo AI Gateway (fallback LLM) - Get free key at https://kilo.ai
KILO_API_KEY=your_kilo_api_key
KILO_API_BASE=https://api.kilo.ai/v1

# Telegram Notifications - Get bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id